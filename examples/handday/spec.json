  "designPrinciples": [
    {
      "principle": "实心色块定调",
      "detail": "标题栏用大面积实心蓝，一眼确认品牌身份，不做渐变"
    },
    {
      "principle": "橙蓝双色分工",
      "detail": "蓝色=信任/主导航，橙色=行动/促销。两者不混用"
    },
    {
      "principle": "照片代替图标",
      "detail": "分类用真实门头照片，让采购员凭照片认部门，比图标快"
    },
    {
      "principle": "信息密度优先",
      "detail": "一屏放 8-10 个信息块，不给装饰留空间"
    },
    {
      "principle": "商业元素前置",
      "detail": "公告、电话、限时特价、登录引导都在首屏，全是生意"
    },
    {
      "principle": "圆角克制",
      "detail": "主要用 8px，标题栏底部圆角是唯一「造型」"
    },
    {
      "principle": "浅蓝底分层",
      "detail": "页面底 #F2F6FF，卡片纯白，靠色差分层不用阴影"
    }
  ],
  "constraints": {
    "platform": "微信小程序 + 企业微信",
    "notes": [
      "标题栏高度需按胶囊按钮位置动态计算，不能写死",
      "底部需处理 safe-area-inset-bottom",
      "分类网格缩略图建议 1:1，56-64px",
      "公告条可做成滚动跑马灯",
      "登录浮条需覆盖 TabBar 上方，不遮挡内容"
    ]
  }
